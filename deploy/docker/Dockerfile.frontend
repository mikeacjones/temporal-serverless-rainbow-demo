# syntax=docker/dockerfile:1

# The dashboard is plain HTML, CSS and JavaScript with no build step, so there
# is nothing to compile — nginx serves the files and proxies the API, which
# keeps the frontend and backend independently deployable.
# The unprivileged variant runs as a non-root user and keeps its temp paths
# under /tmp, so it needs no CHOWN capability and no writable /var mounts.
FROM nginxinc/nginx-unprivileged:1.29-alpine

COPY frontend/index.html frontend/app.css frontend/app.js /usr/share/nginx/html/
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
